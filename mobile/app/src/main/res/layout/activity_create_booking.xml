<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Step Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/step1Indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/step_indicator_active"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#D1D5DB"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/step2Indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="2"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/step_indicator_inactive"
                android:textColor="#9CA3AF" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#D1D5DB"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/step3Indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="3"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/step_indicator_inactive"
                android:textColor="#9CA3AF" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#D1D5DB"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/step4Indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="4"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/step_indicator_inactive"
                android:textColor="#9CA3AF" />

        </LinearLayout>

        <!-- Step Content Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- STEP 1: Station Selection -->
                <LinearLayout
                    android:id="@+id/step1Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 1: Choose Station"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Charging Station"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinnerStation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:padding="12dp" />

                    <TextView
                        android:id="@+id/tvStationDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_box"
                        android:textSize="14sp"
                        android:textColor="#4B5563"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- STEP 2: Date and Time Selection -->
                <LinearLayout
                    android:id="@+id/step2Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 2: Select Date and Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginBottom="16dp" />

                    <!-- Date Selection -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Reservation Date"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Time Selection -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Time"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinnerStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="End Time"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinnerEndTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Charger Type Selection -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Charger Type"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupCharger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbAC"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔋 AC"
                            android:checked="true"
                            android:padding="12dp" />

                        <RadioButton
                            android:id="@+id/rbDC"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ DC"
                            android:padding="12dp" />

                    </RadioGroup>

                </LinearLayout>

                <!-- STEP 3: Slot Selection -->
                <LinearLayout
                    android:id="@+id/step3Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 3: Select Slot"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvNoSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No available slots. Please try different time."
                        android:textSize="14sp"
                        android:textColor="#EF4444"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- STEP 4: Confirmation -->
                <LinearLayout
                    android:id="@+id/step4Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 4: Confirm Booking"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginBottom="16dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="250dp"
                        android:maxHeight="400dp"
                        android:background="@drawable/bg_confirm_box"
                        android:padding="16dp"
                        android:scrollbars="vertical"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvConfirmDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#1F2937"
                            android:fontFamily="monospace"
                            android:lineSpacingMultiplier="1.4"
                            android:scrollHorizontally="false" />

                    </ScrollView>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous"
                android:textColor="#3B82F6"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B82F6"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Confirm Booking"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>