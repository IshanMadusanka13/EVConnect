<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_update_user"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/edittext_transparent_background"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_ev_owner_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_800"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Search Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_user_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple_600"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNIC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enter_nic_hint"
                android:background="@drawable/edittext_transparent_background"
                android:inputType="text"
                android:textColor="@color/purple_900"
                android:textColorHint="@color/purple_400" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_user_button"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            android:paddingVertical="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Form Container -->
        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Status Display -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_status_placeholder"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Personal Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_information_section"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/purple_600"
                android:layout_marginBottom="16dp" />

            <!-- Gender -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/gender_hint"
                    android:inputType="text"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- First Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/first_name_hint"
                    android:inputType="text"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Last Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/last_name_hint"
                    android:inputType="text"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date of Birth -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDateOfBirth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_of_birth_hint"
                    android:inputType="text"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone_hint"
                    android:inputType="phone"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/address_hint"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vehicle Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_information_section"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/purple_600"
                android:layout_marginBottom="16dp" />

            <!-- Vehicle Type -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVehicleType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vehicle_type_hint"
                    android:inputType="text"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vehicle Model -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVehicleModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vehicle_model_hint"
                    android:inputType="text"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vehicle Plate -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVehiclePlate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vehicle_plate_hint"
                    android:inputType="text"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Battery Capacity -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBatteryCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/battery_capacity_hint"
                    android:inputType="text"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Compatible Charger Types -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compatible_charger_types"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_600"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioChargerTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioAC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_charging_option"
                    android:textColor="@color/purple_700" />

                <RadioButton
                    android:id="@+id/radioDC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dc_fast_option"
                    android:textColor="@color/purple_700" />

                <RadioButton
                    android:id="@+id/radioACDC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_dc_option"
                    android:checked="true"
                    android:textColor="@color/purple_700" />

                <RadioButton
                    android:id="@+id/radioAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/all_types_option"
                    android:textColor="@color/purple_700" />
            </RadioGroup>

            <!-- Account Security Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_security_section"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/purple_600"
                android:layout_marginBottom="16dp" />

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:errorEnabled="true"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/new_password_hint"
                    android:inputType="textPassword"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:errorEnabled="true"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/confirm_password_hint"
                    android:inputType="textPassword"
                    android:textColor="@color/purple_900"
                    android:textColorHint="@color/purple_400" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Update Button -->
            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_ev_owner_button"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/purple_500"
                android:paddingVertical="16dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Deactivate Button -->
            <Button
                android:id="@+id/btnDeactivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_deactivate"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/status_cancelled"
                android:paddingVertical="16dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>