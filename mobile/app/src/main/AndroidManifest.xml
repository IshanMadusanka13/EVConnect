<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.evcharging">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Camera permission for QR code scanning (if needed) -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Location permissions for nearby stations (if needed) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EVCharging"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EVCharging">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Booking List Activity -->
        <activity
            android:name=".ui.bookings.BookingListActivity"
            android:exported="false"
            android:label="My Bookings"
            android:parentActivityName=".MainActivity" />

        <!-- Create Booking Activity -->
        <activity
            android:name=".ui.bookings.CreateBookingActivity"
            android:exported="false"
            android:label="Create Booking"
            android:parentActivityName=".ui.bookings.BookingListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Booking Details Activity -->
        <activity
            android:name=".ui.bookings.BookingDetailsActivity"
            android:exported="false"
            android:label="Booking Details"
            android:parentActivityName=".ui.bookings.BookingListActivity" />

        <!-- Map Activity to show nearby charging stations -->
        <activity
            android:name=".ui.stations.StationsMapActivity"
            android:exported="false"
            android:label="Nearby Stations"
            android:parentActivityName=".MainActivity" />

        <!-- Google Maps API key placeholder: replace with your API key in local or gradle properties -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/AIzaSyA4GMwhaR_OivyJD3S_g47tmvUHMgir1eQ" />

    </application>

</manifest>