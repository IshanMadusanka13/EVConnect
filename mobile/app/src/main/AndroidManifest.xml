<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.evcharging">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera permission for QR code scanning (if needed) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Location permissions for nearby stations (if needed) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EVCharging"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EVCharging">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Booking List Activity -->
        <activity
            android:name=".ui.bookings.BookingListActivity"
            android:exported="false"
            android:label="My Bookings"
            android:parentActivityName=".MainActivity" />

        <!-- Create Booking Activity -->
        <activity
            android:name=".ui.bookings.CreateBookingActivity"
            android:exported="false"
            android:label="Create Booking"
            android:parentActivityName=".ui.bookings.BookingListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Booking Details Activity -->
        <activity
            android:name=".ui.bookings.BookingDetailsActivity"
            android:exported="false"
            android:label="Booking Details"
            android:parentActivityName=".ui.bookings.BookingListActivity" />

        <!-- User Management Activities -->
        <activity
            android:name=".ui.users.CreateUserActivity"
            android:exported="false"
            android:label="Create User"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.users.UpdateUserActivity"
            android:exported="false"
            android:label="Update User"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.users.DeactivateUserActivity"
            android:exported="false"
            android:label="Deactivate User"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.users.DeleteUserActivity"
            android:exported="false"
            android:label="Delete User"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
